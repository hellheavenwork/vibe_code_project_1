# ─────────────────────────────────────────────────────────────────────────────
# TaskFlow — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Local development (relative path from project root)
DATABASE_URL="file:./server/prisma/taskflow.db"
# Docker (path inside the container volume)
# DATABASE_URL="file:/app/data/taskflow.db"

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED — Generate a strong random secret (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-random-secret"
JWT_EXPIRES_IN="24h"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Optional: Google Gemini AI ────────────────────────────────────────────────
GEMINI_API_KEY=""
