# Dependencies (will be installed fresh inside the image)
node_modules/

# Build outputs
dist/
server/dist/

# Database files (use Docker volume instead)
server/prisma/*.db
server/prisma/*.db-journal
server/prisma/*.db-wal
server/prisma/*.db-shm

# Environment files (pass via docker-compose env or --env-file)
.env
.env.local
.env*.local

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test / coverage
coverage/

# Docker files themselves (no need to copy into build context)
docker-compose*.yml
Dockerfile*
